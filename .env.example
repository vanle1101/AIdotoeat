# Copy this file to .env outside version control and fill only values you own.
# Empty payment fields intentionally disable that payment destination.
AUTOPROFIT_ADMIN_API_KEY=
AUTOPROFIT_BUDGET_KILL_SWITCH=true
AUTOPROFIT_ENGINE_KILL_SWITCH=true
AUTOPROFIT_ENGINE_WORKER=false

# Local-first LLM. `auto` uses only already-running local providers; it never downloads weights.
AUTOPROFIT_LLM_PROVIDER=auto
AUTOPROFIT_OLLAMA_ENDPOINT=http://127.0.0.1:11434
AUTOPROFIT_LLM_LOCAL_ENDPOINT=
AUTOPROFIT_LLM_LOCAL_MODEL=
AUTOPROFIT_LLM_TIMEOUT_SECONDS=45
AUTOPROFIT_LLM_CONTEXT_TOKENS=4096

# Remote OpenAI-compatible use stays unavailable unless every safety field is explicitly reviewed.
# Use a dedicated key; generic OPENAI_API_KEY and ChatGPT Plus credentials are never read.
AUTOPROFIT_LLM_ENDPOINT=
AUTOPROFIT_LLM_MODEL=
AUTOPROFIT_LLM_API_KEY=
AUTOPROFIT_LLM_ZERO_BILLING_REVIEWED=false
AUTOPROFIT_LLM_ZERO_BILLING_TERMS_URL=
AUTOPROFIT_LLM_REQUEST_QUOTA=0
AUTOPROFIT_LLM_PAYMENT_METHOD_EXPOSED=

AUTOPROFIT_BANK_NAME=
AUTOPROFIT_BANK_ACCOUNT_NO=
AUTOPROFIT_BANK_ACCOUNT_NAME=
AUTOPROFIT_SECONDARY_BANK_NAME=
AUTOPROFIT_SECONDARY_BANK_ACCOUNT_NO=
AUTOPROFIT_SECONDARY_BANK_ACCOUNT_NAME=
AUTOPROFIT_BINANCE_PAY_ID=
AUTOPROFIT_BINANCE_USDT_BEP20=
AUTOPROFIT_BSC_USDT_WALLET=
AUTOPROFIT_BSC_RPC_URL=
AUTOPROFIT_BSC_USDT_CONTRACT=

AUTOPROFIT_AADS_UNIT_ID_TOP=
AUTOPROFIT_AADS_UNIT_ID_BOTTOM=
AUTOPROFIT_MONETAG_TAG_ID=
AUTOPROFIT_MONETAG_ZONE_ID=
AUTOPROFIT_BINANCE_REF_ID=
AUTOPROFIT_SHOPIFY_REF_URL=
AUTOPROFIT_AMAZON_REF_URL=
