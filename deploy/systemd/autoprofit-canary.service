[Unit]
Description=AUTOProfit AI isolated canary API
After=network.target
ConditionPathIsDirectory=/var/www/autoprofit-canary/current

[Service]
Type=simple
User=autoprofit-canary
Group=autoprofit-canary
WorkingDirectory=/var/www/autoprofit-canary/current
EnvironmentFile=/etc/autoprofit-canary.env
Environment=AUTOPROFIT_ENV=staging
Environment=AUTOPROFIT_DATA_DIR=/var/lib/autoprofit-canary/backend-data
Environment=AUTOPROFIT_CORE_DATA_DIR=/var/lib/autoprofit-canary/core-data
Environment=AUTOPROFIT_OUTPUTS_DIR=/var/lib/autoprofit-canary/outputs
Environment=AUTOPROFIT_ENGINE_WORKER=false
Environment=AUTOPROFIT_ENGINE_KILL_SWITCH=true
Environment=AUTOPROFIT_BUDGET_KILL_SWITCH=true
Environment=AUTOPROFIT_TEST_MODE_ENABLED=false
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/autoprofit-canary/ms-playwright
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/autoprofit-canary/current/.venv/bin/uvicorn main:app --app-dir /var/www/autoprofit-canary/current/backend --host 127.0.0.1 --port 8451 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
StateDirectory=autoprofit-canary
StateDirectoryMode=0700
LogsDirectory=autoprofit-canary
LogsDirectoryMode=0750
StandardOutput=append:/var/log/autoprofit-canary/app.log
StandardError=append:/var/log/autoprofit-canary/app.log
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
ReadWritePaths=/var/lib/autoprofit-canary /var/log/autoprofit-canary

[Install]
WantedBy=multi-user.target
